{
  "comment": "Cloth tearing: a heavy ball smashes through a sheet stretched between two bars; overstretched fabric rips open (tear / tear_strain).",
  "settings": {
    "resolution": [1280, 720], "fps": 24, "frame_range": [1, 60], "samples": 64,
    "output": "render/cloth_tear/frame_####.png", "video": "render/cloth_tear.mp4"
  },
  "dynamics": {"substeps": 10},
  "environment": {"type": "sky", "sun_elevation": 40, "sun_azimuth": 210, "strength": 1.0},
  "materials": {
    "floor": {"preset": "studio_floor"},
    "canvas": {"preset": "fabric", "base_color": {"type": "checker", "scale": 8, "color1": "#e9e1cf", "color2": "#c0392b"}, "thin_walled": true},
    "bar": {"preset": "brushed_metal"},
    "ball": {"preset": "chrome"}
  },
  "nodes": [
    {"name": "camera", "type": "camera", "translate": [0, 3.4, 6.5], "look_at": [0, 1.4, 0], "focal_length": 30},
    {"name": "floor", "type": "mesh", "primitive": "plane", "size": 40, "material": "floor"},
    {"name": "bar_l", "type": "mesh", "primitive": "cylinder", "radius": 0.05, "height": 2.6, "translate": [-1.3, 2.0, 0], "rotate": [90, 0, 0], "material": "bar"},
    {"name": "bar_r", "type": "mesh", "primitive": "cylinder", "radius": 0.05, "height": 2.6, "translate": [1.3, 2.0, 0], "rotate": [90, 0, 0], "material": "bar"},
    {"name": "ball", "type": "mesh", "primitive": "uv_sphere", "radius": 0.45, "material": "ball",
     "translate": {"keys": [[1, [0.1, 4.2, 0.05]], [14, [0.1, 2.0, 0.05]], [40, [0.1, 0.45, 0.05]]], "interp": "linear"}},
    {"name": "sheet", "type": "cloth", "size": 2.6, "resolution": 44, "translate": [0, 2.0, 0],
     "material": "canvas", "pin": ["edge_min_x", "edge_max_x"], "stiffness": 1.0, "bend": 0.05,
     "damping": 0.01, "thickness": 0.02, "friction": 0.3, "colliders": ["ball"],
     "tear": true, "tear_strain": 1.35, "tear_max": 8, "start_frame": 1}
  ]
}
